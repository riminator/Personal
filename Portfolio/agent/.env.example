# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=                         # set if using a non-OpenAI provider (e.g. z.ai)

# ── Email via Resend (resend.com — free tier: 3k emails/mo) ──────────────────
RESEND_API_KEY=re_...
FROM_EMAIL=twin@yourdomain.com           # must be verified in Resend dashboard
TO_EMAIL=akshaymall@utexas.edu

# ── Supabase ──────────────────────────────────────────────────────────────────
# Used for: leads table, availability setting, profile context (optional)
#
# Required tables (run in Supabase SQL editor):
#
#   CREATE TABLE leads (
#       id         UUID DEFAULT gen_random_uuid() PRIMARY KEY,
#       name       TEXT,
#       email      TEXT NOT NULL,
#       notes      TEXT,
#       created_at TIMESTAMPTZ DEFAULT now()
#   );
#
#   CREATE TABLE settings (
#       key   TEXT PRIMARY KEY,
#       value TEXT NOT NULL
#   );
#   INSERT INTO settings (key, value)
#   VALUES ('availability', 'open to internships and research roles for Summer 2026');
#
#   -- Optional: profile context (replaces linkedin.pdf + summary.txt)
#   CREATE TABLE profile_context (
#       key   TEXT PRIMARY KEY,
#       value TEXT NOT NULL
#   );
#
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# ── ntfy.sh (backup push notifications) ──────────────────────────────────────
NTFY_TOPIC=Akshay_Notification_Portfolio_Agent

# ── GitHub (public repos — no auth needed for public) ────────────────────────
GITHUB_USER=riminator

# ── Calendly (set once you have a link) ──────────────────────────────────────
CALENDLY_URL=https://calendly.com/your-link

# ── Availability (fallback if Supabase settings table not configured) ─────────
AVAILABILITY=open to internships and research roles for Summer 2026

# ── Server ────────────────────────────────────────────────────────────────────
PORT=10000
