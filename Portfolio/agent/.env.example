# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Pushover (optional — alerts for contact captures & unknown questions) ─────
PUSHOVER_USER=
PUSHOVER_TOKEN=

# ── Supabase (optional — enables DB-backed context instead of local files) ────
# Once set, context.py will pull summary + LinkedIn text from the DB.
# Table: profile_context  |  Columns: key TEXT, value TEXT
SUPABASE_URL=
SUPABASE_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=7860
